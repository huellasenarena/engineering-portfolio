---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import { projects, projectUrl } from '../../data/projects';

export function getStaticPaths() {
  return projects
    .filter((p) => p.caseStudy)
    .map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
---

<Layout
  title={`${project.title} — Jack Stefanou`}
  description={project.summary}
  altPath={projectUrl(project.slug, 'en')}
>
  <Header current="projects" altUrl={projectUrl(project.slug, 'en')} />
  <main>
    <CaseStudy project={project} lang="es" />
  </main>
</Layout>
