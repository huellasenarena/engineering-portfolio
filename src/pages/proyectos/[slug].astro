---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import { projects, projectUrl } from '../../data/projects';

export function getStaticPaths() {
  return projects
    .filter((p) => p.caseStudy)
    .map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const cs = project.caseStudy!.es;
---

<Layout
  title={`${project.es.title} — Jack Stefanou`}
  description={cs.tagline}
  altPath={projectUrl(project.slug, 'en')}
>
  <Header altUrl={projectUrl(project.slug, 'en')} />
  <main>
    <CaseStudy project={project} lang="es" />
  </main>
</Layout>
