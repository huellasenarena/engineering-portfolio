---
import type { Project } from '../data/projects';
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { projectUrl } from '../data/projects';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const content = project[lang];

// Con case study → página propia. Sin case study → sitio en vivo si existe. WIP → sin enlace.
const href = project.wip
  ? undefined
  : project.caseStudy
    ? projectUrl(project.slug, lang)
    : project.link;
const external = !project.caseStudy && !!project.link;
---

<li class:list={['proyecto', { wip: project.wip }]}>
  {href ? (
    <a class="titulo" href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>{content.title}</a>
  ) : (
    <span class="titulo">{content.title}</span>
  )}
  <p class="desc">{project.wip ? t('projects.wip') : content.solution}</p>
  <p class="meta" aria-label={t('projects.stack')}>{project.stack.join(' · ')}</p>
</li>

<style>
  .proyecto {
    margin: 0 0 28px;
  }

  .titulo {
    font-size: 1.15rem;
  }

  .desc {
    margin: 4px 0;
    font-size: var(--t-texto);
    color: #333;
  }

  .meta {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--gris);
  }

  .wip,
  .wip .desc {
    color: var(--gris-claro);
  }
</style>
