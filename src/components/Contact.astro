---
import { existsSync } from 'node:fs';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// The PDFs come from Google Docs via .github/workflows/actualizar-cv.yml
const cvAvailable = existsSync('public/cv-es.pdf') && existsSync('public/cv-en.pdf');
// LinkedIn profile is dormant — set to your URL and flip to true to enable
const linkedinAvailable = false;
const linkedinUrl = 'https://www.linkedin.com/in/USERNAME';
const soon = t('contact.cv.soon');

// The address never appears in the HTML: reversed + base64, rebuilt by the script below.
const emailEncoded = 'bW9jLmxpYW1nQHVvbmFmZXRza2Nhag==';
---

<section class="container pagina">
  <h1 class="titulo-pagina">{t('contact.title')}</h1>

  <dl class="contacto">
    <dt>{t('contact.email')}</dt>
    <dd><a class="correo" data-e={emailEncoded}>…</a></dd>

    <dt>{t('contact.github')}</dt>
    <dd><a href="https://github.com/huellasenarena" target="_blank" rel="noopener">github.com/huellasenarena</a></dd>

    <dt>{t('contact.linkedin')}</dt>
    <dd>
      {linkedinAvailable ? (
        <a href={linkedinUrl} target="_blank" rel="noopener">{linkedinUrl.replace('https://www.', '')}</a>
      ) : (
        <span class="pronto">{soon}</span>
      )}
    </dd>

    <dt>{t('contact.cv')}</dt>
    <dd>
      {cvAvailable ? (
        <>
          <a href="/cv-es.pdf" target="_blank" rel="noopener">{t('contact.cv.es')}</a>
          <span class="sep">·</span>
          <a href="/cv-en.pdf" target="_blank" rel="noopener">{t('contact.cv.en')}</a>
          <span class="formato">PDF</span>
        </>
      ) : (
        <span class="pronto">{soon}</span>
      )}
    </dd>
  </dl>
</section>

<script>
  for (const a of document.querySelectorAll<HTMLAnchorElement>('a.correo')) {
    const email = atob(a.dataset.e ?? '').split('').reverse().join('');
    a.href = `mailto:${email}`;
    a.textContent = email;
  }
</script>

<style>
  .contacto {
    display: grid;
    grid-template-columns: 9rem 1fr;
    max-width: 560px;
    margin: 0;
    font-size: var(--t-texto);
  }

  .contacto dt,
  .contacto dd {
    margin: 0;
    padding: 10px 0;
    border-top: 1px solid var(--linea-suave);
  }

  .contacto dt {
    color: var(--gris);
  }

  .sep {
    color: var(--gris-claro);
    margin: 0 6px;
  }

  .formato {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--gris-claro);
    margin-left: 10px;
  }

  .pronto {
    color: var(--gris-claro);
  }

  @media (max-width: 480px) {
    .contacto {
      grid-template-columns: 1fr;
    }
    .contacto dd {
      border-top: none;
      padding-top: 0;
    }
    .contacto dt {
      padding-bottom: 2px;
    }
  }
</style>
