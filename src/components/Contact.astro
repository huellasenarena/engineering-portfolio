---
import { existsSync } from 'node:fs';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// The PDFs come from Google Docs via .github/workflows/actualizar-cv.yml
const cvAvailable = existsSync('public/cv-es.pdf') && existsSync('public/cv-en.pdf');
// LinkedIn profile is dormant — set to your URL and flip to true to enable
const linkedinAvailable = false;
const linkedinUrl = 'https://www.linkedin.com/in/USERNAME';
const soon = t('contact.cv.soon');
---

<section class="container pagina">
  <h1 class="titulo-pagina">{t('contact.title')}</h1>

  <div class="enlaces">
    <a href="https://github.com/huellasenarena" target="_blank" rel="noopener">{t('contact.github')}</a>

    {linkedinAvailable ? (
      <a href={linkedinUrl} target="_blank" rel="noopener">{t('contact.linkedin')}</a>
    ) : (
      <span class="pronto">{t('contact.linkedin')} · {soon}</span>
    )}

    {cvAvailable ? (
      <>
        <a href="/cv-es.pdf" download>{t('contact.cv')} (ES)</a>
        <a href="/cv-en.pdf" download>{t('contact.cv')} (EN)</a>
      </>
    ) : (
      <span class="pronto">CV · {soon}</span>
    )}
  </div>
</section>

<style>
  .enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: var(--t-texto);
  }

  .pronto {
    color: var(--gris-claro);
  }
</style>
