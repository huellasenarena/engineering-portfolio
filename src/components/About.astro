---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const languages = lang === 'es'
  ? [
      { name: 'Inglés',   level: 'Nativo' },
      { name: 'Español',  level: 'B2 / C1' },
      { name: 'Francés',  level: 'DALF C1' },
      { name: 'Griego',   level: 'B2' },
    ]
  : [
      { name: 'English',  level: 'Native' },
      { name: 'Spanish',  level: 'B2 / C1' },
      { name: 'French',   level: 'DALF C1' },
      { name: 'Greek',    level: 'B2' },
    ];
---

<section id="about" data-reveal>
  <div class="container container--narrow">
    <h2 class="section-title">{t('about.title')}</h2>
    <p class="body-text">{t('about.body')}</p>

    <div class="languages">
      {languages.map(({ name, level }) => (
        <div class="lang-item">
          <span class="lang-name">{name}</span>
          <span class="lang-level">{level}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--text);
    margin-bottom: 2rem;
  }

  .body-text {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 2.5rem;
  }

  .languages {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 480px) {
    .languages {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .lang-item {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.875rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    transition: border-color var(--transition);
  }

  .lang-item:hover {
    border-color: var(--accent);
  }

  .lang-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }

  .lang-level {
    font-size: 0.8rem;
    color: var(--accent);
    font-weight: 500;
  }
</style>
