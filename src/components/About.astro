---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const languages = lang === 'es'
  ? [
      { name: 'Inglés',   level: 'Nativo' },
      { name: 'Español',  level: 'DELE C1' },
      { name: 'Francés',  level: 'DALF C1' },
      { name: 'Griego',   level: 'B2' },
    ]
  : [
      { name: 'English',  level: 'Native' },
      { name: 'Spanish',  level: 'DELE C1' },
      { name: 'French',   level: 'DALF C1' },
      { name: 'Greek',    level: 'B2' },
    ];
---

<section id="about" class="container seccion">
  <h2 class="titulo-seccion">{t('about.title')}</h2>
  <p class="texto cuerpo">{t('about.body')}</p>

  <ul class="idiomas">
    {languages.map(({ name, level }) => (
      <li><span>{name}</span><span class="nivel">{level}</span></li>
    ))}
  </ul>
</section>

<style>
  .cuerpo {
    font-size: 0.97rem;
    line-height: 1.7;
    margin: 0 0 28px;
  }

  .idiomas {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 420px;
    font-size: var(--t-texto);
  }

  .idiomas li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 7px 0;
    border-top: 1px solid var(--linea-suave);
  }

  .nivel {
    color: var(--gris);
  }
</style>
