---
import type { Project } from '../data/projects';
import type { Lang } from '../i18n/utils';
import { useTranslations, pageUrl } from '../i18n/utils';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const cs = project.caseStudy!;
const backHref = pageUrl('projects', lang);

// Marcadores [lo escribe Jack: …] solo en `npm run dev`
const isMarker = (p: string) => p.startsWith('[lo escribe Jack');
const visible = (body: string[]) => body.filter((p) => import.meta.env.DEV || !isMarker(p));

// *palabra* → itálica (el resto del texto se escapa)
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const html = (s: string) => esc(s).replace(/\*(.+?)\*/g, '<em>$1</em>');

const diagramInline = cs.sections.some((s) => s.diagram);
---

<article class="cs container">
  <a href={backHref} class="volver">← {t('nav.projects')}</a>

  <header class="cs__header">
    <h1>{project.title}</h1>
    {(project.link || project.github || project.repoNote) && (
      <p class="meta">
        {project.link && <a href={project.link} target="_blank" rel="noopener">{t('cs.viewLive')}</a>}
        {project.link && (project.github || project.repoNote) && ' · '}
        {project.github && <a href={project.github} target="_blank" rel="noopener">{t('cs.viewCode')}</a>}
        {!project.github && project.repoNote}
      </p>
    )}
  </header>

  {cs.sections.map((s, i) => (
    <section class="texto">
      <h2>{s.title}</h2>
      {visible(s.body).map((p, j) => (
        <p class:list={{ lead: i === 0 && j === 0, marca: isMarker(p) }} set:html={html(p)} />
      ))}
      {s.diagram && cs.architecture && (
        <div class="diagrama"><pre>{cs.architecture}</pre></div>
      )}
    </section>
  ))}

  {!diagramInline && cs.architecture && (
    <section>
      <h2>{t('cs.architecture')}</h2>
      <div class="diagrama"><pre>{cs.architecture}</pre></div>
    </section>
  )}

  <section class="texto">
    <h2>{t('cs.stack')}</h2>
    <div class="tabla-wrap">
      <table class="stack">
        <thead>
          <tr><th class="etiqueta">{t('cs.stack.layer')}</th><th class="etiqueta">{t('cs.stack.tech')}</th></tr>
        </thead>
        <tbody>
          {cs.stack.map((row) => (
            <tr><td>{row.layer}</td><td>{row.tech}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</article>

<style>
  .cs {
    margin-top: 48px;
    padding-bottom: 80px;
  }

  .volver {
    font-size: var(--t-nav);
  }

  .cs__header {
    margin-top: 36px;
  }

  h1 {
    margin: 0 0 8px;
  }


  .meta {
    font-size: 0.85rem;
    color: var(--gris);
    margin: 0;
  }

  .marca {
    color: var(--gris-claro);
    font-style: italic;
  }

  .diagrama { margin-top: 8px; }


  section { margin-top: 44px; }

  h2 { margin: 0 0 14px; }

  section p {
    font-size: 0.97rem;
    line-height: 1.7;
    margin: 0 0 18px;
  }

  /* Letra capital, como en Análisis du jour */
  p.lead::first-letter {
    float: left;
    font-size: 3.2rem;
    line-height: 0.9;
    margin: 2px 6px 0 0;
  }


  .diagrama {
    overflow-x: auto;
    border-left: 1px solid var(--linea-fuerte);
    padding: 4px 0 4px 18px;
  }
  .diagrama pre {
    margin: 0;
    font-size: 0.74rem;
    line-height: 1.55;
    color: #333;
  }

  .tabla-wrap { overflow-x: auto; }
  .stack {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .stack th {
    text-align: left;
    font-weight: normal;
    padding: 0 0 8px;
  }
  .stack td {
    padding: 8px 0;
    border-top: 1px solid var(--linea-suave);
    vertical-align: top;
  }
  .stack td:first-child {
    color: var(--gris);
    width: 34%;
    padding-right: 16px;
  }
  .stack td:last-child {
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.6;
  }




  @media (max-width: 600px) {
    p.lead::first-letter { font-size: 2.6rem; margin-top: 1px; }
  }
</style>
