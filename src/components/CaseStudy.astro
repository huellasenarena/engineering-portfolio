---
import type { Project } from '../data/projects';
import type { Lang } from '../i18n/utils';
import { useTranslations, pageUrl } from '../i18n/utils';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const cs = project.caseStudy![lang];
const content = project[lang];
const backHref = pageUrl('projects', lang);
---

<article class="cs container">
  <a href={backHref} class="volver">← {t('nav.projects')}</a>

  <header class="cs__header">
    <h1>{content.title}</h1>
    <p class="tagline">{cs.tagline}</p>
    <p class="meta">
      {cs.meta}
      {project.link && <> · <a href={project.link} target="_blank" rel="noopener">{t('cs.viewLive')}</a></>}
      {project.github && <> · <a href={project.github} target="_blank" rel="noopener">{t('cs.viewCode')}</a></>}
    </p>

    {cs.metrics.length > 0 && (
      <div class="cols">
        {cs.metrics.map((m) => (
          <div class="col">
            <div class="col-num">{m.value}{m.suffix ?? ''}</div>
            <div class="col-lab">{m.label}</div>
          </div>
        ))}
      </div>
    )}
  </header>

  <section class="texto">
    <h2>{t('cs.overview')}</h2>
    {cs.overview.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
  </section>

  <section class="texto">
    <h2>{t('cs.problem')}</h2>
    {cs.problem.map((p) => <p>{p}</p>)}
  </section>

  <section class="texto">
    <h2>{t('cs.solution')}</h2>
    <p>{cs.solutionIntro}</p>
    <ol class="pasos">
      {cs.steps.map((step) => <li>{step}</li>)}
    </ol>
  </section>

  {cs.architecture && (
    <section>
      <h2>{t('cs.architecture')}</h2>
      <div class="diagrama"><pre>{cs.architecture}</pre></div>
      <p class="nota">{t('cs.diagramNote')}</p>
    </section>
  )}

  <section class="texto">
    <h2>{t('cs.stack')}</h2>
    <div class="tabla-wrap">
      <table class="stack">
        <thead>
          <tr><th class="etiqueta">{t('cs.stack.layer')}</th><th class="etiqueta">{t('cs.stack.tech')}</th></tr>
        </thead>
        <tbody>
          {cs.stack.map((row) => (
            <tr><td>{row.layer}</td><td>{row.tech}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="texto">
    <h2>{t('cs.challenges')}</h2>
    {cs.challenges.map((c) => (
      <div class="reto">
        <h3>{c.title}</h3>
        <p>{c.body}</p>
      </div>
    ))}
  </section>

  <section class="texto">
    <h2>{t('cs.results')}</h2>
    <ul class="resultados">
      {cs.results.map((r) => <li>{r}</li>)}
    </ul>
  </section>

  <section class="texto">
    <h2>{t('cs.demonstrates')}</h2>
    <blockquote class="cierre">{cs.demonstrates}</blockquote>
  </section>
</article>

<style>
  .cs {
    margin-top: 48px;
    padding-bottom: 80px;
  }

  .volver {
    font-size: var(--t-nav);
  }

  .cs__header {
    margin-top: 36px;
  }

  h1 {
    margin: 0 0 8px;
  }

  .tagline {
    font-style: italic;
    color: var(--gris);
    margin: 0 0 4px;
  }

  .meta {
    font-size: 0.85rem;
    color: var(--gris);
    margin: 0 0 32px;
  }

  /* Métricas: tres columnas con líneas finas, números fijos */
  .cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 600px;
    border-top: 1px solid var(--linea-suave);
    padding-top: 18px;
    margin-bottom: 8px;
  }
  .col {
    text-align: center;
    padding: 0 6px;
    border-left: 1px solid var(--linea-suave);
  }
  .col:first-child { border-left: 0; }
  .col-num {
    font-size: 2.2rem;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }
  .col-lab {
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--gris);
    margin-top: 4px;
  }

  section { margin-top: 44px; }

  h2 { margin: 0 0 14px; }

  section p {
    font-size: 0.97rem;
    line-height: 1.7;
    margin: 0 0 18px;
  }

  /* Letra capital, como en Análisis du jour */
  p.lead::first-letter {
    float: left;
    font-size: 3.2rem;
    line-height: 0.9;
    margin: 2px 6px 0 0;
  }

  .pasos {
    list-style: none;
    counter-reset: paso;
    margin: 0;
    padding: 0;
  }
  .pasos li {
    counter-increment: paso;
    display: grid;
    grid-template-columns: 2em 1fr;
    margin-bottom: 14px;
    font-size: 0.97rem;
    line-height: 1.7;
  }
  .pasos li::before {
    content: counter(paso) ".";
    color: var(--gris);
  }

  .diagrama {
    overflow-x: auto;
    border-left: 1px solid var(--linea-fuerte);
    padding: 4px 0 4px 18px;
  }
  .diagrama pre {
    margin: 0;
    font-size: 0.74rem;
    line-height: 1.55;
    color: #333;
  }
  .nota {
    font-size: var(--t-pequeno) !important;
    font-style: italic;
    color: var(--gris);
    margin-top: 12px !important;
  }

  .tabla-wrap { overflow-x: auto; }
  .stack {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .stack th {
    text-align: left;
    font-weight: normal;
    padding: 0 0 8px;
  }
  .stack td {
    padding: 8px 0;
    border-top: 1px solid var(--linea-suave);
    vertical-align: top;
  }
  .stack td:first-child {
    color: var(--gris);
    width: 34%;
    padding-right: 16px;
  }
  .stack td:last-child {
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .reto { margin-bottom: 18px; }
  .reto h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 2px;
  }
  .reto p {
    font-size: var(--t-texto);
    color: #333;
    margin: 0;
  }

  .resultados {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .resultados li {
    padding: 8px 0;
    border-top: 1px solid var(--linea-suave);
    font-size: 0.97rem;
    line-height: 1.65;
  }

  .cierre {
    font-style: italic;
    font-size: 1rem;
    line-height: 1.7;
    color: #333;
  }

  @media (max-width: 600px) {
    .col-num { font-size: 1.7rem; }
    .col-lab { font-size: 0.72rem; }
    p.lead::first-letter { font-size: 2.6rem; margin-top: 1px; }
  }
</style>
