---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Slideshow del hero — cada foto en public/photos/ con su pie de foto (es / en).
// Pies vacíos = no se muestra nada en el sitio. En `npm run dev` aparece un marcador para verlos.
const heroPhotos = [
  { file: 'fountain.jpg', caption: { es: 'Nunca se mueve, pero, dependiendo del punto de vista, está más cerca o más lejos de los cielos', en: '' } },
  { file: 'jet.jpg',      caption: { es: 'Lo viejo en primer plano, pero por debajo de lo nuevo', en: '' } },
  { file: 'skater.jpg',   caption: { es: 'La mitad nos cautiva más que el fin', en: '' } },
  { file: 'street.jpg',   caption: { es: 'La universidad. La intersección. Tomé la izquierda.', en: '' } },
];

const showMarker = import.meta.env.DEV;
const captions = heroPhotos.map(({ file, caption }) =>
  caption[lang] || (showMarker ? `[pie de foto: ${file} — lo escribe Jack]` : '')
);
---

<section class="hero container" id="hero">
  <h1>{t('hero.tagline')}</h1>
  <p class="sub">{t('hero.sub')}</p>

  <figure>
    <div class="foto">
      {heroPhotos.map(({ file }, i) => (
        <img
          src={`/photos/${file}`}
          alt=""
          class:list={{ oculta: i !== 0 }}
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      ))}
    </div>
    <div class="pies">
      {captions.map((c, i) => (
        <figcaption class:list={['pie', { oculta: i !== 0 }]}>
          {c && <>{c}<span class="sep">·</span></>}<span class="credito">{t('hero.credit')}</span>
        </figcaption>
      ))}
    </div>
  </figure>
</section>

<style>
  .hero {
    margin-top: 72px;
    padding-bottom: 80px;
  }

  /* Excepción de la portada: la frase es más grande para no quedar aplastada por las fotos */
  h1 {
    font-size: 2.1rem;
    line-height: 1.25;
    margin: 0 0 12px;
  }

  .sub {
    color: var(--gris);
    font-size: 1.05rem;
    margin: 0 0 40px;
  }

  figure {
    margin: 0;
  }

  .foto {
    position: relative;
    aspect-ratio: 3 / 2;
    max-width: 100%;
    overflow: hidden;
  }

  .foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Sin recortes: la foto entera, el sobrante queda en blanco (papel) */
    object-fit: contain;
    object-position: left center;
    transition: opacity 1.2s ease;
  }

  /* Los pies se apilan en el mismo lugar y cambian junto con la foto */
  .pies {
    display: grid;
    margin-top: 10px;
  }

  .pie {
    grid-area: 1 / 1;
    font-size: var(--t-pequeno);
    font-style: italic;
    color: var(--gris);
    transition: opacity 1.2s ease;
  }

  .sep {
    margin: 0 6px;
    color: var(--gris-claro);
  }

  .credito {
    font-style: normal;
    color: var(--gris-claro);
  }

  .oculta {
    opacity: 0;
  }

  @media (max-width: 600px) {
    h1 { font-size: 1.7rem; }
  }
</style>

<script>
  // Fundido entre fotos (y sus pies). Con reduced-motion, base.css quita la transición y el cambio es instantáneo.
  const fotos = Array.from(document.querySelectorAll<HTMLImageElement>('.foto img'));
  const pies = Array.from(document.querySelectorAll<HTMLElement>('.pie'));
  if (fotos.length > 1) {
    fotos.forEach((img) => (img.loading = 'eager'));
    let actual = 0;
    setInterval(() => {
      fotos[actual].classList.add('oculta');
      pies[actual]?.classList.add('oculta');
      actual = (actual + 1) % fotos.length;
      fotos[actual].classList.remove('oculta');
      pies[actual]?.classList.remove('oculta');
    }, 6500);
  }
</script>
