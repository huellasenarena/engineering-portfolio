---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const contactHref = lang === 'es' ? '/#contact' : '/en/#contact';
const projectsHref = lang === 'es' ? '/#projects' : '/en/#projects';

// Slideshow del hero — añadir/quitar nombres de public/photos/ para cambiar la rotación
const heroPhotos = ['fountain.jpg', 'jet.jpg', 'skater.jpg', 'street.jpg'];
---

<section class="hero container" id="hero">
  <h1>{t('hero.tagline')}</h1>
  <p class="sub">{t('hero.sub')}</p>

  <div class="enlaces">
    <a href="https://github.com/huellasenarena" target="_blank" rel="noopener">{t('hero.cta.github')}</a>
    <a href={projectsHref}>{t('hero.scroll')}</a>
    <a href={contactHref}>{t('hero.cta.contact')}</a>
  </div>

  <figure class="foto">
    {heroPhotos.map((photo, i) => (
      <img
        src={`/photos/${photo}`}
        alt=""
        class:list={{ oculta: i !== 0 }}
        loading={i === 0 ? 'eager' : 'lazy'}
      />
    ))}
  </figure>
</section>

<style>
  .hero {
    margin-top: 64px;
  }

  h1 {
    margin: 0 0 10px;
  }

  .sub {
    color: var(--gris);
    font-size: var(--t-texto);
    margin: 0 0 20px;
  }

  .enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: var(--t-texto);
    margin-bottom: 36px;
  }

  .foto {
    position: relative;
    aspect-ratio: 3 / 2;
    max-width: 100%;
    margin: 0;
    background: var(--linea-suave);
    overflow: hidden;
  }

  .foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 1.2s ease;
  }

  .foto img.oculta {
    opacity: 0;
  }
</style>

<script>
  // Fundido entre fotos. Con reduced-motion, base.css quita la transición y el cambio es instantáneo.
  const fotos = Array.from(document.querySelectorAll<HTMLImageElement>('.foto img'));
  if (fotos.length > 1) {
    fotos.forEach((img) => (img.loading = 'eager'));
    let actual = 0;
    setInterval(() => {
      fotos[actual].classList.add('oculta');
      actual = (actual + 1) % fotos.length;
      fotos[actual].classList.remove('oculta');
    }, 6500);
  }
</script>
