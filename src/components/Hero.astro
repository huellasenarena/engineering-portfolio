---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Slideshow del hero — añadir/quitar nombres de public/photos/ para cambiar la rotación
const heroPhotos = ['fountain.jpg', 'jet.jpg', 'skater.jpg', 'street.jpg'];
---

<section class="hero container" id="hero">
  <h1>{t('hero.tagline')}</h1>
  <p class="sub">{t('hero.sub')}</p>

  <figure class="foto">
    {heroPhotos.map((photo, i) => (
      <img
        src={`/photos/${photo}`}
        alt=""
        class:list={{ oculta: i !== 0 }}
        loading={i === 0 ? 'eager' : 'lazy'}
      />
    ))}
  </figure>
</section>

<style>
  .hero {
    margin-top: 64px;
    padding-bottom: 80px;
  }

  h1 {
    margin: 0 0 10px;
  }

  .sub {
    color: var(--gris);
    font-size: var(--t-texto);
    margin: 0 0 36px;
  }


  .foto {
    position: relative;
    aspect-ratio: 3 / 2;
    max-width: 100%;
    margin: 0;
    overflow: hidden;
  }

  .foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Sin recortes: la foto entera, el sobrante queda en blanco (papel) */
    object-fit: contain;
    object-position: left center;
    transition: opacity 1.2s ease;
  }

  .foto img.oculta {
    opacity: 0;
  }
</style>

<script>
  // Fundido entre fotos. Con reduced-motion, base.css quita la transición y el cambio es instantáneo.
  const fotos = Array.from(document.querySelectorAll<HTMLImageElement>('.foto img'));
  if (fotos.length > 1) {
    fotos.forEach((img) => (img.loading = 'eager'));
    let actual = 0;
    setInterval(() => {
      fotos[actual].classList.add('oculta');
      actual = (actual + 1) % fotos.length;
      fotos[actual].classList.remove('oculta');
    }, 6500);
  }
</script>
