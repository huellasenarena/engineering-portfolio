---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const contactHref = lang === 'es' ? '/#contact' : '/en/#contact';
const projectsHref = lang === 'es' ? '/#projects' : '/en/#projects';

// Hero background slideshow — add/remove filenames in public/photos/ to change rotation
const heroPhotos = ['fountain.jpg', 'jet.jpg', 'skater.jpg', 'street.jpg'];
---

<section class="hero" id="hero">
  <div class="hero__bg" aria-hidden="true">
    {heroPhotos.map((photo, i) => (
      <div
        class:list={['hero__slide', { 'is-active': i === 0 }]}
        style={`background-image: url('/photos/${photo}')`}
      />
    ))}
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="container hero__content">
    <h1 class="hero__tagline">{t('hero.tagline')}</h1>
    <p class="hero__sub">{t('hero.sub')}</p>

    <div class="hero__ctas">
      <a href="https://github.com/huellasenarena" target="_blank" rel="noopener" class="btn btn--outline">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        {t('hero.cta.github')}
      </a>
      <a href={contactHref} class="btn btn--accent">{t('hero.cta.contact')}</a>
    </div>
  </div>

  <a href={projectsHref} class="hero__scroll" aria-label={t('hero.scroll')}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M6 9l6 6 6-6"/>
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: -10% 0;
    transform: scale(1.12) translateY(0);
    will-change: transform;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 40%;
    opacity: 0;
    transition: opacity 1.6s ease;
  }

  .hero__slide.is-active {
    opacity: 1;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(15, 14, 13, 0.88) 0%,
      rgba(15, 14, 13, 0.72) 50%,
      rgba(15, 14, 13, 0.82) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-top: 6rem;
    max-width: 760px;
  }

  .hero__content > * {
    opacity: 0;
    transform: translateY(22px);
    animation: heroFadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero__tagline {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 5vw, 3.75rem);
    font-weight: 700;
    color: var(--text);
    line-height: 1.15;
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
    animation-delay: 200ms;
  }

  .hero__sub {
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    color: var(--text-muted);
    letter-spacing: 0.02em;
    margin-bottom: 2.5rem;
    animation-delay: 380ms;
  }

  .hero__ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    animation-delay: 540ms;
  }

  @keyframes heroFadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: background-color var(--transition), border-color var(--transition),
                color var(--transition), transform var(--transition);
    cursor: pointer;
  }

  .btn:active {
    transform: scale(0.97);
  }

  .btn--outline {
    border: 1px solid var(--border);
    color: var(--text-muted);
    background: transparent;
  }

  .btn--outline:hover {
    border-color: var(--text-muted);
    color: var(--text);
    background: rgba(255,255,255,0.04);
  }

  .btn--accent {
    background: var(--accent);
    color: var(--bg);
    border: 1px solid transparent;
    font-weight: 600;
  }

  .btn--accent:hover {
    background: var(--accent-hover);
  }

  .hero__scroll {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--text-subtle);
    z-index: 1;
    animation: bounce 2.4s ease infinite;
    transition: color var(--transition);
  }

  .hero__scroll:hover {
    color: var(--text-muted);
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(6px); }
  }
</style>

<script>
  // Subtle parallax on the hero photo
  const bg = document.querySelector<HTMLElement>('.hero__bg');
  const hero = document.querySelector<HTMLElement>('.hero');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (bg && hero && !reduce) {
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      if (y < hero.offsetHeight) {
        bg.style.transform = `scale(1.12) translateY(${y * 0.18}px)`;
      }
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });
  }

  // Cross-fade slideshow between hero photos
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.hero__slide'));
  if (slides.length > 1 && !reduce) {
    // Preload the non-active photos so the first transition is smooth
    slides.slice(1).forEach((s) => {
      const url = s.style.backgroundImage.slice(5, -2);
      const img = new Image();
      img.src = url;
    });

    let current = 0;
    setInterval(() => {
      slides[current].classList.remove('is-active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('is-active');
    }, 6500);
  }
</script>
