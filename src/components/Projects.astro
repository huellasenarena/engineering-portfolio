---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const featured = projects.filter((p) => !p.wip);
const wip = projects.filter((p) => p.wip);
---

<section id="projects" class="container seccion">
  <h2 class="titulo-seccion">{t('projects.title')}</h2>
  <ul class="lista">
    {featured.map((p) => <ProjectCard project={p} lang={lang} />)}
    {wip.map((p) => <ProjectCard project={p} lang={lang} />)}
  </ul>
</section>

<style>
  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 650px;
  }
</style>
