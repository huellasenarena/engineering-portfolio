---
import { getLangFromUrl, getAlternateUrl, useTranslations } from '../i18n/utils';

interface Props {
  altUrl?: string;
}

const { altUrl } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const alternateLang = lang === 'es' ? 'en' : 'es';
const alternateUrl = altUrl ?? getAlternateUrl(Astro.url, alternateLang);

const homeHref = lang === 'es' ? '/' : '/en/';
const projectsHref = `${homeHref}#projects`;
const aboutHref = `${homeHref}#about`;
const contactHref = `${homeHref}#contact`;
---

<header class="container">
  <nav>
    <div class="nav-left">
      <a href={homeHref} class="nombre">Jack Stefanou</a>
      <a href={projectsHref}>{t('nav.projects')}</a>
      <a href={aboutHref}>{t('nav.about')}</a>
      <a href={contactHref}>{t('nav.contact')}</a>
    </div>
    <span class="lang">
      <span aria-current="true">{lang.toUpperCase()}</span>
      /
      <a href={alternateUrl} hreflang={alternateLang} aria-label={alternateLang === 'en' ? 'English' : 'Español'}>
        {alternateLang.toUpperCase()}
      </a>
    </span>
  </nav>
</header>

<style>
  header {
    margin-top: 40px;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 24px;
    font-size: var(--t-nav);
  }

  .nav-left {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }

  .nombre {
    margin-right: 12px;
  }

  .lang {
    margin-left: auto;
    color: var(--gris);
  }

  .lang [aria-current] {
    color: var(--tinta);
  }
</style>
