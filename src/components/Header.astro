---
import { getLangFromUrl, getAlternateUrl, useTranslations, pageUrl, showEnglish, type Page } from '../i18n/utils';

interface Props {
  altUrl?: string;
  current?: Page;
}

const { altUrl, current } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const alternateLang = lang === 'es' ? 'en' : 'es';
const alternateUrl = altUrl ?? (current ? pageUrl(current, alternateLang) : getAlternateUrl(Astro.url, alternateLang));

const links: { page: Page; label: string }[] = [
  { page: 'projects', label: t('nav.projects') },
  { page: 'about', label: t('nav.about') },
  { page: 'contact', label: t('nav.contact') },
];
---

<header class="container">
  <nav>
    <div class="nav-left">
      <a href={pageUrl('home', lang)} class="nombre" aria-current={current === 'home' ? 'page' : undefined}>Jack Stefanou</a>
      {links.map(({ page, label }) => (
        <a href={pageUrl(page, lang)} aria-current={current === page ? 'page' : undefined}>{label}</a>
      ))}
    </div>
    {showEnglish && <span class="lang">
      {(['es', 'en'] as const).map((l, i) => (
        <>
          {i > 0 && ' / '}
          {l === lang ? (
            <span class="lang-actual">{l.toUpperCase()}</span>
          ) : (
            <a href={alternateUrl} hreflang={l} aria-label={l === 'en' ? 'English' : 'Español'}>{l.toUpperCase()}</a>
          )}
        </>
      ))}
    </span>}
  </nav>
</header>

<style>
  header {
    margin-top: 40px;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 28px;
    /* Excepción de este proyecto: nav un poco más grande que en QMP, para equilibrar las fotos */
    font-size: 1.05rem;
  }

  .nav-left {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
  }

  .nombre {
    margin-right: 16px;
    font-size: 1.15rem;
  }

  /* En la portada el nombre no se subraya: ya estás ahí */
  .nombre[aria-current] {
    border-bottom-color: transparent;
  }

  .lang {
    margin-left: auto;
    color: var(--gris);
  }

  .lang-actual {
    color: var(--tinta);
  }
</style>
