---
import '../styles/global.css';
import { getLangFromUrl, getAlternateUrl } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Jack Stefanou', description = 'Full-stack developer specializing in AI.' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const alternateLang = lang === 'es' ? 'en' : 'es';
const alternateUrl = getAlternateUrl(Astro.url, alternateLang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
